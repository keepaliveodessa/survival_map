# ===== Survival Map — шаблон .env =====
# Скопируйте в .env (gitignored) и заполните реальными значениями:
#   cp .env.example .env
# Секреты НЕ должны попадать в git — .env в .gitignore.

# --- Обязательные ---
# Токен бота от @BotFather. Без него core (aiogram-бот) не стартует (R-C8).
BOT_TOKEN=

# Секрет подписи JWT, >= 32 символов. При отсутствии/плейсхолдере core не стартует.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# ID канала Telegram для парсинга (формат: -100XXXXXXXXXX).
CHANNEL_ID=-1002050105527

# --- PostgreSQL (совпадают с POSTGRES_* в docker-compose) ---
POSTGRES_USER=postgres
# ОБЯЗАТЕЛЬНО, без дефолта (M-1): сервисы не стартуют с отсутствующим,
# слабым (< 8 символов) или insecure-дефолтным паролем ('postgres', 'password', ...).
POSTGRES_PASSWORD=
# Хост PostgreSQL. По умолчанию 'postgres' (прямое подключение).
# Для PgBouncer (connection pooling): POSTGRES_HOST=pgbouncer
# POSTGRES_HOST=postgres

# --- Опционально ---
# Валидация Telegram initData/JWT (строгий парсинг, Secure by Default):
#   По умолчанию/при любом некорректном значении — TRUE. 'false' или '0' —
#   единственный триггер dev-bypass.
# 'false' — открытый доступ для локальной разработки (НЕ для прода).
# TELEGRAM_WEBVIEW_VALIDATION=true

# Публичный HTTPS-URL приложения (для прод Mini App; кнопка «Открыть приложение»).
WEBAPP_URL=

# Куда отправлять не-Telegram трафик при включённой валидации.
REDIRECT_URL=

# КАЛИБРОВКА МАТЧЕРА / GEO-АРБИТРАЖ (порог fuzzy-матча, score кандидатов,
# буферы пересечения, POS-фильтр) — НЕ env: правится хардкодными дефолтами
# в common/settings.py (SimilarityConfig / GeoConfig). Переменные вида
# ENTITY_*/GEO_* нигде не читаются и эффекта не имеют (см. аудит v2, L-находки).
