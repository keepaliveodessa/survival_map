# Dockerfile.parser — Parser service (kurigram + text preprocessing + photo download)
# Multi-stage build для минимизации размера образа

# =============================================================================
# Stage 1: Builder
# =============================================================================
FROM python:3.11.14-slim-bookworm AS builder

WORKDIR /build

COPY parser/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --user --no-cache-dir -r requirements.txt && \
    find /root/.local -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true && \
    find /root/.local -type f -name "*.pyc" -delete && \
    find /root/.local -type f -name "*.pyo" -delete && \
    find /root/.local -type f -name "*.md" -delete

ENV PATH="/root/.local/bin:$PATH"
RUN python -c "from pyrogram import Client; print('✅ kurigram OK')" && \
    python -c "import prometheus_client; print('✅ prometheus_client OK')"

# =============================================================================
# Stage 2: Runtime (минимальный образ)
# =============================================================================
FROM python:3.11.14-slim-bookworm

LABEL maintainer="survival-map" \
      description="Telegram client (kurigram) + text preprocessing + photo download" \
      org.opencontainers.image.source="https://github.com/survival-map"

WORKDIR /app

ENV PYTHONUNBUFFERED="1"
ENV PYTHONDONTWRITEBYTECODE="1"
ENV PATH="/home/parser/.local/bin:$PATH"

COPY --from=builder --chown=parser:parser /root/.local /home/parser/.local

RUN useradd -m -u 1000 parser && \
    chmod 1777 /tmp && \
    mkdir -p /media/events && \
    chown -R parser:parser /app /media/events

COPY --chown=parser:parser parser/ ./parser/
COPY --chown=parser:parser common/ ./common/

USER parser

CMD ["python", "-m", "parser.monitoring"]
