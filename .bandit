[bandit]
# Exclude test files, docs, postgres SQL scripts, and model binaries
exclude_dirs = tests,docs,postgres,nlp_processor/models,scripts,/web/node_modules
# Skip rules that produce false positives or are acceptable in this codebase:
# B101 — assert used in tests (tests are excluded, but some scripts use assert)
# B404 — import subprocess (used in standalone scripts, not deployed)
# B603 — subprocess call (used in standalone scripts, not deployed)
# B608 — hardcoded SQL expressions (SQL is static strings with parameterized args)
# B311 — random (used for non-security purposes)
skips = B101,B404,B603,B608,B311
# Only report MEDIUM and higher severity
number = 2
level = 2
