{
  "uid": "survival-logs",
  "title": "Survival Map — Logs",
  "tags": ["survival-map", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Сервис",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({service=~\".+\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume по сервисам (лог-строк/сек)",
      "description": "Суммарный объём логов в секунду по каждому сервису — всплески ошибок видны сразу",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate({service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "ERROR/CRIT логи по сервисам",
      "description": "detected_level=error|critical — индикатор проблем (у json-логов level извлекается автоматически)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate({service=~\"$service\", detected_level=\"error\"}[5m]))",
          "legendFormat": "err {{service}}",
          "queryType": "range"
        },
        {
          "refId": "B",
          "expr": "sum by (service) (rate({service=~\"$service\", detected_level=\"critical\"}[5m]))",
          "legendFormat": "crit {{service}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Все логи (streaming)",
      "description": "Живой поток логов выбранных сервисов",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\"}",
          "queryType": "range"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Только ошибки (core / parser / nlp_processor)",
      "description": "Фильтр по уровню error|critical — детальный разбор инцидентов",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\", detected_level=~\"error|critical\"}",
          "queryType": "range"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "signature"
      }
    }
  ]
}
