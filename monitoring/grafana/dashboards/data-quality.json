{
  "uid": "survival-data-quality",
  "title": "Survival Map — Data Quality",
  "tags": ["survival-map"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Geo-located (1h)",
      "description": "Доля геолоцированных событий за час: 1 − доля strategy=random. Цель ≥ 85% (потолок справочника ~90%+: часть сообщений реально не содержит топонимов)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "targets": [{
        "refId": "A",
        "expr": "1 - (sum(rate(nlp_processor_strategy_total{strategy=\"random\"}[1h])) / sum(rate(nlp_processor_strategy_total[1h])))",
        "legendFormat": "geo-located"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "green", "value": 0.85 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Random share (1h)",
      "description": "Доля негеолоцированных (strategy=random) событий за час. Алерт-порог: > 50% — деградация матчинга или пробелы geo-справочника (см. postgres/quality_report.sql). Для push-алерта создать Grafana Alert Rule на этот запрос",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(nlp_processor_strategy_total{strategy=\"random\"}[1h])) / sum(rate(nlp_processor_strategy_total[1h]))",
        "legendFormat": "random"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.3 }, { "color": "red", "value": 0.5 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Geo-miss (1h)",
      "description": "Сообщения с реальным текстом (>= 3 токенов, не промо), но без ни одного geo-кандидата — основной сигнал пробелов справочника. Топ причин: postgres/quality_report.sql (запрос 4)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(nlp_processor_geo_miss_total[1h]))",
        "legendFormat": "geo-miss/s"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.05 }, { "color": "red", "value": 0.15 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Strategy distribution (15m, доли)",
      "description": "Распределение стратегий геометрии по доле: single_match/intersection/street_segment/weighted_centroid — точная геометрия; random — нет привязки. Сумма = 1",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(nlp_processor_strategy_total[15m])) by (strategy) / sum(rate(nlp_processor_strategy_total[15m]))",
        "legendFormat": "{{strategy}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Geo-miss vs processed",
      "description": "Поток geo-miss на фоне общего потока обработанных сообщений: рост доли = деградация матчинга или новые топонимы вне справочника",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(nlp_processor_geo_miss_total[15m]))", "legendFormat": "geo-miss/s" },
        { "refId": "B", "expr": "sum(rate(nlp_processor_messages_processed_total[15m]))", "legendFormat": "processed/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    }
  ]
}
